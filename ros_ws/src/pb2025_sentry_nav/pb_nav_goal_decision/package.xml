<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pb_nav_goal_decision</name>
  <version>0.0.1</version>
  <description>Auto goal decision node for sentry navigation (FSM: game-start→center, low-HP→spawn, loop-back).</description>
  <maintainer email="dev@example.com">dev</maintainer>
  <license>Apache-2.0</license>

  <!-- Core ROS2 -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml-cpp</depend>

  <!-- Arbitration: read the action's own status topic to detect goals sent by
       other clients (RViz Nav2 Goal / joystick auto_control). -->
  <depend>action_msgs</depend>

  <!-- Localization readiness: `map -> odom` is watched on the tf topics. -->
  <depend>tf2_msgs</depend>

  <!-- Nav2 action interface (navigate_to_pose) -->
  <depend>nav2_msgs</depend>

  <!-- Referee-system inputs are plain std_msgs relayed by the forwarding/serial node. -->
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
